# Copy to orange/.env (git-ignored) and fill in. bootRun, the tests and docker compose read it.

# Max-plan token for subscription runs (the default routing). Create it with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# LiteLLM admin key (any long random string). Only needed for gateway tiers and `--profile gateway`.
LITELLM_MASTER_KEY=

# Anthropic API key for LiteLLM's gateway tiers only; leave empty to keep all runs on the subscription.
ANTHROPIC_API_KEY=

# HMAC secret shared with the GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# Token orange uses to push branches and open PRs; it never reaches an agent run.
ORANGE_GITHUB_TOKEN=

# owner/name of the repo orange works on.
ORANGE_GITHUB_REPO=

# Branch PRs target and worktrees branch from.
ORANGE_GITHUB_BASE_BRANCH=

# Local checkout of that repo that worktrees are created from.
WORKTREES_BASE_REPO=
