# Copy to orange/.env (git-ignored) and fill in. bootRun, the tests and docker compose read it.

# Max-plan token for subscription runs (the default routing). Create it with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# LiteLLM admin key (any long random string). Only needed for gateway tiers and `--profile gateway`.
LITELLM_MASTER_KEY=

# Anthropic API key for LiteLLM's gateway tiers only; leave empty to keep all runs on the subscription.
ANTHROPIC_API_KEY=

# HMAC secret shared with the GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# GitHub API token for the later PR integration mode; it never reaches an agent run. Merge mode
# (the default) pushes with the host's own git credentials.
ORANGE_GITHUB_TOKEN=

# owner/name of the repo orange works on.
ORANGE_GITHUB_REPO=

# Branch worktrees branch from and verified work is integrated onto (default main).
ORANGE_GITHUB_BASE_BRANCH=

# Local checkout of that repo that worktrees are created from and integrated into.
WORKTREES_BASE_REPO=

# Where task worktrees live; keep it outside every repository. Blank = ~/.orange/worktrees.
WORKTREES_ROOT=

# Where agents reach orange's worker MCP endpoint. Blank = http://127.0.0.1:<server port>/mcp/worker,
# which is right whenever agents run on the coordinator's host.
ORANGE_MCP_WORKER_URL=
