{
  "mcpServers": {
    "orange": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PROJECT_DIR}/orange-mcp",
        "run",
        "orange-mcp"
      ],
      "env": {
        "ORANGE_BASE_URL": "${ORANGE_URL:-http://localhost:8080}",
        "ORANGE_API_TOKEN": "${ORANGE_API_TOKEN:-}"
      }
    }
  }
}
