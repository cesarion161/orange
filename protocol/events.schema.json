{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.local/schemas/events.schema.json",
  "title": "AgentRunnerEvent",
  "description": "NDJSON events emitted by agent-runner on stdout. One JSON object per line.",
  "oneOf": [
    { "$ref": "#/$defs/Ready" },
    { "$ref": "#/$defs/AssistantMessage" },
    { "$ref": "#/$defs/Thinking" },
    { "$ref": "#/$defs/ToolUse" },
    { "$ref": "#/$defs/ToolResult" },
    { "$ref": "#/$defs/HookRequest" },
    { "$ref": "#/$defs/SubagentStart" },
    { "$ref": "#/$defs/SubagentEnd" },
    { "$ref": "#/$defs/Cost" },
    { "$ref": "#/$defs/Final" },
    { "$ref": "#/$defs/Error" }
  ],
  "$defs": {
    "Ready": {
      "type": "object",
      "required": ["type", "session_id"],
      "properties": {
        "type": { "const": "ready" },
        "session_id": { "type": "string" },
        "sdk_version": { "type": "string" }
      }
    },
    "AssistantMessage": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "assistant_message" },
        "text": { "type": "string" },
        "usage": {
          "type": "object",
          "properties": {
            "input": { "type": "integer" },
            "output": { "type": "integer" },
            "cache_read": { "type": "integer" },
            "cache_creation": { "type": "integer" }
          }
        }
      }
    },
    "Thinking": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "thinking" },
        "text": { "type": "string" }
      }
    },
    "ToolUse": {
      "type": "object",
      "required": ["type", "id", "tool", "input"],
      "properties": {
        "type": { "const": "tool_use" },
        "id": { "type": "string" },
        "tool": { "type": "string" },
        "input": { "type": "object" }
      }
    },
    "ToolResult": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "const": "tool_result" },
        "id": { "type": "string" },
        "is_error": { "type": "boolean" },
        "output": { "type": "string" }
      }
    },
    "HookRequest": {
      "type": "object",
      "description": "Round-trip permission decision request. Java replies with hook_response on stdin.",
      "required": ["type", "id", "event", "tool", "input"],
      "properties": {
        "type": { "const": "hook_request" },
        "id": { "type": "string" },
        "event": { "type": "string", "enum": ["PreToolUse", "PostToolUse", "UserPromptSubmit"] },
        "tool": { "type": "string" },
        "input": { "type": "object" }
      }
    },
    "SubagentStart": {
      "type": "object",
      "required": ["type", "agent"],
      "properties": {
        "type": { "const": "subagent_start" },
        "agent": { "type": "string" },
        "parent_id": { "type": "string" }
      }
    },
    "SubagentEnd": {
      "type": "object",
      "required": ["type", "agent"],
      "properties": {
        "type": { "const": "subagent_end" },
        "agent": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "Cost": {
      "type": "object",
      "required": ["type", "usd"],
      "properties": {
        "type": { "const": "cost" },
        "usd": { "type": "number" },
        "tokens": {
          "type": "object",
          "properties": {
            "in": { "type": "integer" },
            "out": { "type": "integer" }
          }
        }
      }
    },
    "Final": {
      "type": "object",
      "required": ["type", "status"],
      "properties": {
        "type": { "const": "final" },
        "status": { "type": "string", "enum": ["success", "failure", "cancelled"] },
        "summary": { "type": "string" },
        "artifacts": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "Error": {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
