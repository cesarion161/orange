{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orange.local/schemas/commands.schema.json",
  "title": "AgentRunnerCommand",
  "description": "NDJSON commands sent to agent-runner on stdin. One JSON object per line.",
  "oneOf": [
    { "$ref": "#/$defs/Start" },
    { "$ref": "#/$defs/HookResponse" },
    { "$ref": "#/$defs/Signal" },
    { "$ref": "#/$defs/Cancel" }
  ],
  "$defs": {
    "Start": {
      "type": "object",
      "required": ["type", "prompt"],
      "properties": {
        "type": { "const": "start" },
        "prompt": { "type": "string" },
        "options": {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "fallback_model": { "type": "string" },
            "system_prompt": { "type": "string" },
            "allowed_tools": { "type": "array", "items": { "type": "string" } },
            "disallowed_tools": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string" },
            "max_turns": { "type": "integer" },
            "max_budget_usd": { "type": "number" },
            "permission_mode": { "type": "string" },
            "agents": { "type": "object" },
            "mcp_servers": { "type": "object" },
            "hooks_via_runner": {
              "type": "array",
              "description": "Hook events the orchestrator wants to round-trip through.",
              "items": { "type": "string", "enum": ["PreToolUse", "PostToolUse", "UserPromptSubmit"] }
            }
          }
        }
      }
    },
    "HookResponse": {
      "type": "object",
      "required": ["type", "id", "decision"],
      "properties": {
        "type": { "const": "hook_response" },
        "id": { "type": "string" },
        "decision": { "type": "string", "enum": ["allow", "block"] },
        "reason": { "type": "string" }
      }
    },
    "Signal": {
      "type": "object",
      "description": "External signal (e.g. webhook delivered by orchestrator).",
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "signal" },
        "name": { "type": "string" },
        "payload": {}
      }
    },
    "Cancel": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "cancel" },
        "reason": { "type": "string" }
      }
    }
  }
}
